# Copia este archivo como .env para desarrollo local (no se sube a git).
# En producción, estas mismas variables se configuran en el panel de Vercel
# (Project Settings -> Environment Variables).

# Connection string de Supabase (Settings -> Database -> Connection string -> modo "Transaction pooler", puerto 6543)
# Reemplaza [YOUR-PASSWORD] por la contraseña que definiste al crear el proyecto.
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Si no defines DATABASE_URL, la app usa un archivo SQLite local (local_dev.db) automáticamente,
# útil para probar el flujo sin necesitar Supabase todavía.

# URL pública real del sitio (usada para armar los links de vuelta y el webhook de Mercado Pago).
SITE_URL=https://mirrorlaboral.cl

# Mercado Pago (Checkout Pro) -- Access Token y Public Key desde tu cuenta de Mercado Pago Developers.
# Si se dejan vacías, el Mirror 2 funciona en "modo de pago simulado" (útil para probar el formulario
# completo y la generación de documentos sin cobrar de verdad).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Gmail SMTP para el envío de documentos y notificaciones. GMAIL_APP_PASSWORD es una "contraseña de
# aplicación" de Google (no la contraseña normal de la cuenta) -- se genera en la configuración de
# seguridad de la cuenta de Google, con verificación en dos pasos activada.
GMAIL_USER=mirrorlaboral@gmail.com
GMAIL_APP_PASSWORD=

# Correo interno donde llegan las alertas de riesgo (protocolo de riesgo). Si se deja vacío, se usa
# GMAIL_USER como destino por defecto.
INTERNAL_ALERT_EMAIL=

# Panel de leads derivados: una contraseña simple por profesional, y el correo de cada una (solo para
# la notificación de "nuevo caso disponible", nunca para enviar contenido sensible).
PAZ_PASSWORD=
PAZ_EMAIL=
ABOGADA_PASSWORD=
ABOGADA_EMAIL=

# Firma de las cookies de sesión del panel -- en producción, un valor largo y aleatorio propio.
SESSION_SECRET=
