# Copia este archivo como .env para desarrollo local (no se sube a git).
# En producción, estas mismas variables se configuran en el panel de Vercel
# (Project Settings -> Environment Variables).

# Connection string de Supabase (Settings -> Database -> Connection string -> modo "Transaction pooler", puerto 6543)
# Reemplaza [YOUR-PASSWORD] por la contraseña que definiste al crear el proyecto.
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Si no defines DATABASE_URL, la app usa un archivo SQLite local (local_dev.db) automáticamente,
# útil para probar el flujo sin necesitar Supabase todavía.
